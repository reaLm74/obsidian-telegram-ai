#!/usr/bin/env sh

# Pre-commit hook: Lint, type-check, and validate bundle size
# Runs before every commit to catch issues that would fail the Obsidian community plugin review

echo "🔍 Running pre-commit checks..."

# 1. ESLint (includes obsidianmd plugin rules)
#
# The SAME command CI runs (`npm run lint`), deliberately without --max-warnings 0. The
# tree carries 15 accepted warnings that cannot be cleared without breaking the design:
# `fetch` in the Bot API client is what makes a long poll abortable; the Node built-ins
# are in test files, except `buffer` in the GramJS converter (the npm polyfill, and GramJS
# wants a Buffer); `setWarning` and `setDynamicTooltip` stay because their replacements
# need Obsidian 1.13 while minAppVersion is 1.8.7; and the sentence-case hits are API-key
# placeholders ("sk-...", an OpenRouter URL) that must be shown verbatim. With the strict flag this step
# failed on a clean checkout, so the hook rejected every commit — including the ones fixing
# things. A gate stricter than CI, that nothing in the repo can satisfy, only teaches
# --no-verify.
#
# Never run `eslint --fix` over the whole tree without reading the diff: auto-fixable
# obsidianmd rules rewrite environment-sensitive code (`globalThis` → `window` in the test
# setup broke every test file at once). The mocks are exempted in eslint.config.mjs now.
echo "  → ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Fix errors before committing."
  exit 1
fi

# 2. TypeScript type checking
echo "  → TypeScript..."
npx tsc -noEmit -skipLibCheck
if [ $? -ne 0 ]; then
  echo "❌ TypeScript type check failed. Fix errors before committing."
  exit 1
fi

# 3. Unit tests
#
# CI runs these on every PR, and they take ~5 s — an order of magnitude less than the
# production build this hook already waits for. Catching a broken invariant here rather
# than in CI is the whole point of a pre-commit hook.
echo "  → Unit tests..."
npm run test:unit
if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Run 'npm run test:unit' to see the failures."
  exit 1
fi

# 4. Production build + bundle size check
echo "  → Building production bundle..."
node esbuild.config.mjs production
if [ $? -ne 0 ]; then
  echo "❌ Production build failed."
  exit 1
fi

# Run post-build if it exists
if [ -f "post-build.mjs" ]; then
  node post-build.mjs
fi

# Bundle size is enforced by the production build itself (3.5 MB ceiling in
# esbuild.config.mjs, which step 4 just ran) — no separate check needed here.

# 5. Validate manifest.json structure
echo "  → Validating manifest.json..."
node -e "
  const m = require('./manifest.json');
  const required = ['id', 'name', 'version', 'minAppVersion', 'description', 'author', 'isDesktopOnly'];
  const missing = required.filter(k => !(k in m));
  if (missing.length) { console.error('Missing manifest keys:', missing.join(', ')); process.exit(1); }
  const v = require('./versions.json');
  if (!(m.version in v)) { console.error('versions.json missing entry for', m.version); process.exit(1); }
  if (v[m.version] !== m.minAppVersion) { console.error('versions.json minAppVersion mismatch:', v[m.version], 'vs', m.minAppVersion); process.exit(1); }
  console.log('  ✓ manifest.json valid');
"
if [ $? -ne 0 ]; then
  echo "❌ Manifest validation failed."
  exit 1
fi

echo "✅ All pre-commit checks passed!"
