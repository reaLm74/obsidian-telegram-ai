{
	"name": "telegram-ai",
	"version": "0.1.6",
	"description": "AI-powered Telegram sync with smart categorization, media grouping, and local document processing.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs && npm run post-build",
		"lint": "eslint src/",
		"lint-fix": "eslint --fix src/",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node esbuild.config.mjs test && npm run post-build && node install-plugin.mjs",
		"release-notes-check": "node release-notes.mjs check",
		"build": "tsc -noEmit -skipLibCheck && npm run lint && node esbuild.config.mjs production && npm run post-build",
		"post-build": "node post-build.mjs",
		"prepare": "husky"
	},
	"keywords": [
		"Telegram",
		"AI",
		"Sync",
		"Obsidian",
		"Automation",
		"Smart Categorization",
		"Media Processing",
		"Document Extraction"
	],
	"author": "Evgeniy Berezovskiy",
	"license": "AGPL-3.0",
	"devDependencies": {
		"@eslint/json": "0.14.0",
		"@types/async": "^3.2.18",
		"@types/linkify-it": "^3.0.2",
		"@types/mime-types": "^2.1.1",
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "^8.57.0",
		"@typescript-eslint/parser": "^8.57.0",
		"esbuild": "0.17.3",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "latest",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"eslint-plugin-prettier": "latest",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"obsidian": "^1.13.0",
		"prettier": "latest",
		"release-please": "^16.14.0",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0"
	},
	"dependencies": {
		"@popperjs/core": "^2.11.7",
		"@types/qrcode": "^1.5.0",
		"big-integer": "^1.6.52",
		"compare-versions": "^6.1.0",
		"linkify-it": "^4.0.1",
		"mammoth": "^1.12.0",
		"mime-types": "^2.1.35",
		"node-machine-id": "^1.1.12",
		"node-telegram-bot-api": "^0.67.0",
		"pdf-parse": "^2.4.5",
		"qrcode": "^1.5.3",
		"telegram": "^2.26.22"
	},
	"overrides": {
		"qs": "^6.13.0",
		"uuid": "^11.1.1",
		"lodash": "^4.17.21",
		"@xmldom/xmldom": "^0.9.5",
		"tough-cookie": "^5.1.2",
		"form-data": "^4.0.1",
		"ip": "^2.0.1",
		"es5-ext": "^0.10.64",
		"underscore": "^1.13.7"
	}
}
