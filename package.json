{
	"name": "telegram-ai",
	"version": "0.3.0",
	"description": "AI-powered Telegram sync with smart categorization, media grouping, and local document processing.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs && npm run post-build",
		"lint": "eslint src/",
		"lint-fix": "eslint --fix src/",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node esbuild.config.mjs test && npm run post-build && node install-plugin.mjs",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"release-notes-check": "node release-notes.mjs check",
		"build": "tsc -noEmit -skipLibCheck && npm run lint && node esbuild.config.mjs production && npm run post-build",
		"post-build": "node post-build.mjs",
		"prepare": "husky"
	},
	"keywords": [
		"Telegram",
		"AI",
		"Sync",
		"Obsidian",
		"Automation",
		"Smart Categorization",
		"Media Processing",
		"Document Extraction"
	],
	"author": "Evgeniy Berezovskiy",
	"license": "AGPL-3.0",
	"devDependencies": {
		"@eslint/json": "0.14.0",
		"@types/node": "^22.15.0",
		"@types/qrcode": "^1.5.0",
		"@typescript-eslint/eslint-plugin": "^8.57.0",
		"@typescript-eslint/parser": "^8.57.0",
		"@vitest/coverage-v8": "^4.1.9",
		"esbuild": "0.17.3",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "latest",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-prettier": "latest",
		"globals": "^17.4.0",
		"husky": "^9.1.7",
		"moment": "2.29.4",
		"obsidian": "^1.8.7",
		"prettier": "latest",
		"release-please": "^17.11.2",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@noble/ciphers": "^2.4.0",
		"@noble/hashes": "^2.4.0",
		"big-integer": "^1.6.52",
		"compare-versions": "^6.1.1",
		"jszip": "^3.10.1",
		"linkify-it": "^6.1.0",
		"mammoth": "^1.12.0",
		"pdf-parse": "^2.4.5",
		"qrcode": "^1.5.3",
		"telegram": "2.25.11"
	},
	"overrides": {
		"@xmldom/xmldom": "^0.8.15",
		"es5-ext": "^0.10.64",
		"underscore": "^1.13.7"
	}
}
